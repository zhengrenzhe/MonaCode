  "observableSemantics": {
    "identity": "Every message is addressed by the exact ordered nls.keys module/key identity; the 2120-entry order is retained for differential fixtures.",
    "lookup": "A string locale entry wins; null or absent locale entries use the English fallback string; absence of both yields a typed missing-message failure.",
    "format": "Raw UTF-16 replacement uses the Monaco /\\{(\\d+)\\}/g rule and the first captured digit as the argument index; string, number, boolean, null and absent arguments stringify exactly as Monaco, while other values leave the placeholder unchanged.",
    "localize2": "The result contains localized value plus the separately formatted original English message.",
    "pseudo": "English fallback is wrapped in fullwidth square brackets and every lowercase a, o, u, e or i is doubled in source order.",
    "selection": "The profile is fixed during MonaCodeEnvironment initialization before first service, registry, model or editor access; default is en; unsupported identifiers are rejected and never silently mapped through the system locale.",
    "storage": "Tables are immutable repository-owned Swift resources generated from the pinned MIT artifacts; lookup never calls Foundation localization or a network service."
  },
