{
  "consumerMappings": [
    {
      "construction": "g and u always; i only when matchCase is false; m only when Monaco detects multiline source",
      "execution": "Monaco Searcher, raw captures, zero-length code-point advance, LF multiline view, CRLF compensation and word-separator post-check",
      "fields": "ITextModel find and replace inputs",
      "id": "search",
      "state": "searcher sets numeric lastIndex before exec and exposes capture arrays through FindMatch when requested"
    },
    {
      "construction": "a non-global input is cloned with g plus only its i, m and u flags; d, s, v and y are dropped; a global input object is reused",
      "execution": "lastIndex is reset to zero, then assigned window offsets and consumed by exec",
      "fields": "LanguageConfiguration.wordPattern",
      "id": "word-definition",
      "state": "default maxLen 1000, windowSize 15 and synchronous timeBudget 150 ms remain exact; a clone syntax failure caused by dropped v is not hidden"
    },
    {
      "construction": "input objects are reused",
      "execution": "lastIndex is reset only when global is true, then test is called",
      "fields": "four IndentationRule patterns",
      "id": "indentation",
      "state": "a sticky non-global pattern carries lastIndex across calls exactly as Monaco"
    },
    {
      "construction": "input objects are reused",
      "execution": "lastIndex is unconditionally set to zero immediately before test",
      "fields": "beforeText, afterText and previousLineText",
      "id": "on-enter",
      "state": "rules preserve source order and stop at the first complete match"
    },
    {
      "construction": "when canonical flags strings are equal, compile (start.source)|(noncapturing end.source) with those exact flags",
      "execution": "reset combined lastIndex to zero on every line and use capture group 1 to distinguish start from end",
      "fields": "FoldingMarkers.start and end",
      "id": "folding-range-equal-flags",
      "state": "combined compile errors and capture numbering are observable"
    },
    {
      "construction": "reuse both input objects",
      "execution": "reset each object lastIndex to zero before test; skip end test after a start match",
      "fields": "FoldingMarkers.start and end",
      "id": "folding-range-unequal-flags",
      "state": "start has priority on a line"
    },
    {
      "construction": "clone with the ECMAScript new RegExp(existingRegExp) source and flags rule, resetting clone lastIndex",
      "execution": "test each candidate line without a per-line reset",
      "fields": "FoldingMarkers.start",
      "id": "fold-all-regions",
      "state": "g and y therefore carry clone lastIndex across different candidate-line strings"
    },
    {
      "construction": "reuse the input object",
      "execution": "apply ECMAScript String.prototype.match semantics per line",
      "fields": "FoldingMarkers.start",
      "id": "section-headers",
      "state": "global and sticky lastIndex behavior follows the pinned standard oracle"
    },
    {
      "construction": "reuse the selected input object",
      "execution": "apply String.prototype.match to the reference value and compare match[0].length with the full raw-UTF16 reference length",
      "fields": "LinkedEditingRanges.wordPattern or language wordPattern fallback",
      "id": "linked-editing",
      "state": "provider pattern takes priority over the language pattern"
    },
    {
      "construction": "compile source with the canonical flags string after removing g and preserving every other flag",
      "execution": "apply String.prototype.match to completion text and combine the first word match with whitespace exec",
      "fields": "resolved language wordDefinition",
      "id": "inline-accept-next-word",
      "state": "the temporary clone starts at lastIndex zero"
    }
