{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://monacode.local/contracts/monaco-editor-0.56.0/g6-r/monacode-g6r-execution-schema.json",
  "title": "MonaCode G6-R Execution Plan Schema",
  "description": "Closed contract for the G6-R machine-verifiable execution plan. Every object layer enforces additionalProperties: false. The repository-owned validator (implementation-plan/lib/schema.mjs) enforces both this structural contract and the semantic rules that JSON Schema cannot express (stage/kind compatibility, leaf selection, commit-message/task-ID binding, evidence self-embedding prohibition).",
  "type": "object",
  "additionalProperties": false,
  "required": ["planID", "baseCommit", "planHash", "tasks"],
  "properties": {
    "planID": { "type": "string", "pattern": "^P[0-9]{2}$" },
    "baseCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "planHash": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/TaskRecord" }
    }
  },
  "$defs": {
    "Identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "email"],
      "properties": {
        "name": { "type": "string", "const": "zhengrenzhe" },
        "email": { "type": "string", "const": "zhengrenzhe0416@outlook.com" }
      }
    },
    "PathInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "availability"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "availability": { "enum": ["local", "remote", "generated", "inherited"] }
      }
    },
    "Fixtures": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "values"],
          "properties": {
            "kind": { "const": "inline" },
            "values": { "type": "object" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "path", "hash"],
          "properties": {
            "kind": { "const": "path" },
            "path": { "type": "string", "minLength": 1 },
            "hash": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "Assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "operand"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "operand": { "type": "string", "minLength": 1 }
      }
    },
    "TestCaseContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caseID", "file", "checker", "target", "testSymbol", "fixtures",
        "assertions", "redLeafID", "greenLeafID", "inheritedOutput",
        "failureClass", "authoringOperation", "source"
      ],
      "properties": {
        "caseID": { "type": "string", "minLength": 1 },
        "file": { "$ref": "#/$defs/PathInput" },
        "checker": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "testSymbol": { "type": "string", "minLength": 1 },
        "fixtures": { "$ref": "#/$defs/Fixtures" },
        "assertions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Assertion" } },
        "redLeafID": { "type": "string", "pattern": "^P[0-9]{2}-T[0-9]{3}\\.(RED|GREEN)\\.[0-9]{3}\\.PROC\\.[0-9]{3}$" },
        "greenLeafID": { "type": "string", "pattern": "^P[0-9]{2}-T[0-9]{3}\\.(RED|GREEN)\\.[0-9]{3}\\.PROC\\.[0-9]{3}$" },
        "inheritedOutput": { "type": "boolean" },
        "failureClass": { "enum": ["assertion", "compile", "runtime", "timeout", "crash", "signal"] },
        "authoringOperation": { "type": "string", "minLength": 1 },
        "source": { "enum": ["baseline", "dependency", "task-step"] }
      }
    },
    "TaskTestContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractID", "cases"],
      "properties": {
        "contractID": { "type": "string", "minLength": 1 },
        "cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/TestCaseContract" } }
      }
    },
    "ProcessSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["leafID", "executable", "toolchainRow", "args", "timeoutMs"],
      "properties": {
        "leafID": { "type": "string", "pattern": "^P[0-9]{2}-T[0-9]{3}\\.(RED|GREEN)\\.[0-9]{3}\\.PROC\\.[0-9]{3}$" },
        "executable": { "type": "string", "pattern": "^/" },
        "toolchainRow": { "type": "string", "minLength": 1 },
        "args": { "type": "array", "items": { "type": "string" } },
        "timeoutMs": { "type": "integer", "minimum": 1 }
      }
    },
    "CommandSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commandID", "kind", "networkMode", "timeoutMs", "leaves"],
      "properties": {
        "commandID": { "type": "string", "pattern": "^P[0-9]{2}-T[0-9]{3}\\.(RED|GREEN)\\.[0-9]{3}$" },
        "kind": { "enum": ["process", "all-success", "pipeline"] },
        "networkMode": { "const": "forbidden" },
        "timeoutMs": { "type": "integer", "minimum": 1 },
        "leaves": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ProcessSpec" } },
        "pipefail": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "process" } } },
          "then": { "properties": { "leaves": { "maxItems": 1, "minItems": 1 } }, "not": { "required": ["pipefail"] } }
        },
        {
          "if": { "properties": { "kind": { "const": "all-success" } } },
          "then": { "properties": { "leaves": { "minItems": 2 } }, "not": { "required": ["pipefail"] } }
        },
        {
          "if": { "properties": { "kind": { "const": "pipeline" } } },
          "then": { "properties": { "leaves": { "minItems": 2 }, "pipefail": { "const": true } }, "required": ["pipefail"] }
        }
      ]
    },
    "ArchiveSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format", "entryCount", "exactExpandedBytes", "maxExpandedBytes",
        "extractionRoot", "rejectAbsolute", "rejectTraversal", "rejectSymlinks",
        "rejectHardLinks", "rejectDevices", "rejectDuplicateNormalized",
        "rejectComponentCollisions", "rejectProbeCollisions"
      ],
      "properties": {
        "format": { "type": "string", "minLength": 1 },
        "entryCount": { "type": "integer", "minimum": 1 },
        "exactExpandedBytes": { "type": "integer", "minimum": 1 },
        "maxExpandedBytes": { "type": "integer", "minimum": 1 },
        "extractionRoot": { "type": "string", "minLength": 1 },
        "rejectAbsolute": { "type": "boolean", "const": true },
        "rejectTraversal": { "type": "boolean", "const": true },
        "rejectSymlinks": { "type": "boolean", "const": true },
        "rejectHardLinks": { "type": "boolean", "const": true },
        "rejectDevices": { "type": "boolean", "const": true },
        "rejectDuplicateNormalized": { "type": "boolean", "const": true },
        "rejectComponentCollisions": { "type": "boolean", "const": true },
        "rejectProbeCollisions": { "type": "boolean", "const": true }
      }
    },
    "SourceAcquisition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url", "allowedHost", "redirectChain", "expectedBytes", "maxBytes",
        "sha256", "license", "outputPath", "disposition", "taskOwner",
        "stageOwner", "timeoutMs", "existingOutputBehavior"
      ],
      "properties": {
        "url": { "type": "string", "pattern": "^https://", "not": { "pattern": ":[^/@]*@" } },
        "allowedHost": { "type": "string", "minLength": 1 },
        "redirectChain": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "expectedBytes": { "type": "integer", "minimum": 1 },
        "maxBytes": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "license": { "type": "string", "minLength": 1 },
        "outputPath": { "type": "string", "minLength": 1 },
        "disposition": { "enum": ["temporary", "task-step"] },
        "taskOwner": { "type": "string", "minLength": 1 },
        "stageOwner": { "type": "string", "minLength": 1 },
        "timeoutMs": { "type": "integer", "minimum": 1 },
        "existingOutputBehavior": { "const": "require-same-hash" },
        "archive": { "$ref": "#/$defs/ArchiveSpec" }
      }
    },
    "StageStep": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "action"],
          "properties": {
            "kind": { "const": "controller-action" },
            "action": { "enum": ["begin-task", "commit-task", "finalize-evidence"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "operation"],
          "properties": {
            "kind": { "const": "authoring-operation" },
            "operation": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "command"],
          "properties": {
            "kind": { "const": "verification-command" },
            "command": { "$ref": "#/$defs/CommandSpec" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "acquisition"],
          "properties": {
            "kind": { "const": "source-acquisition" },
            "acquisition": { "$ref": "#/$defs/SourceAcquisition" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "operation"],
          "properties": {
            "kind": { "const": "implementation-operation" },
            "operation": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "StageRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "steps"],
      "properties": {
        "name": { "enum": ["preflight", "test-authoring", "red", "implementation", "green", "commit", "evidence"] },
        "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/StageStep" } }
      }
    },
    "TaskWorkspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ownershipToken", "taskRoot", "planHash", "taskHash", "baseHash", "currentStage", "lifecycleState"],
      "properties": {
        "ownershipToken": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "taskRoot": { "type": "string", "pattern": "^/" },
        "planHash": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "taskHash": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "baseHash": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "currentStage": { "enum": ["preflight", "test-authoring", "red", "implementation", "green", "commit", "evidence"] },
        "lifecycleState": { "enum": ["idle", "running", "complete", "aborted"] }
      }
    },
    "RedScaffold": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourcePath", "declarationText", "declarationHash", "sentinelBehavior", "createOwner", "replacementOwner", "redAssertionID", "finalAbsenceAssertion"],
      "properties": {
        "sourcePath": { "type": "string", "minLength": 1 },
        "declarationText": { "type": "string" },
        "declarationHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "sentinelBehavior": { "enum": ["compile-fail", "runtime-fail", "test-fail"] },
        "createOwner": { "const": "test-authoring" },
        "replacementOwner": { "const": "implementation" },
        "redAssertionID": { "type": "string", "minLength": 1 },
        "finalAbsenceAssertion": { "type": "string", "minLength": 1 }
      }
    },
    "ProductCommitContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["author", "committer", "message", "preflightBaseParent", "stagedProductPaths", "hooksDisabled", "signingDisabled", "evidenceExcluded"],
      "properties": {
        "author": { "$ref": "#/$defs/Identity" },
        "committer": { "$ref": "#/$defs/Identity" },
        "message": { "type": "string", "pattern": "^monacode: complete P[0-9]{2}-T[0-9]{3}$" },
        "preflightBaseParent": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "stagedProductPaths": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[^/]" } },
        "hooksDisabled": { "type": "boolean", "const": true },
        "signingDisabled": { "type": "boolean", "const": true },
        "evidenceExcluded": { "type": "boolean", "const": true }
      }
    },
    "EvidenceCommitContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["author", "committer", "message", "parentCommit", "firstParentSuccessor", "stagedEvidencePath", "laterFirstParentTouches", "hooksDisabled", "signingDisabled", "selectorMode", "prohibitsSelfEmbedding", "evidenceSchema", "verifiedAssertions"],
      "properties": {
        "author": { "$ref": "#/$defs/Identity" },
        "committer": { "$ref": "#/$defs/Identity" },
        "message": { "type": "string", "pattern": "^evidence\\(monacode\\): complete P[0-9]{2}-T[0-9]{3}$" },
        "parentCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "firstParentSuccessor": { "const": "immediate" },
        "stagedEvidencePath": { "type": "string", "minLength": 1 },
        "laterFirstParentTouches": { "type": "integer", "const": 0 },
        "hooksDisabled": { "type": "boolean", "const": true },
        "signingDisabled": { "type": "boolean", "const": true },
        "selectorMode": { "const": "external-git" },
        "prohibitsSelfEmbedding": { "type": "boolean", "const": true },
        "evidenceSchema": { "type": "string", "minLength": 1 },
        "verifiedAssertions": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "TaskRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskID", "stages", "testContract", "completionAssertions", "workspace", "redScaffold", "productCommit", "evidenceCommit"],
      "properties": {
        "taskID": { "type": "string", "pattern": "^P[0-9]{2}-T[0-9]{3}$" },
        "stages": { "type": "array", "minItems": 7, "maxItems": 7, "items": { "$ref": "#/$defs/StageRecord" } },
        "testContract": { "$ref": "#/$defs/TaskTestContract" },
        "completionAssertions": { "type": "array", "minItems": 2, "maxItems": 4, "items": { "type": "string", "minLength": 1 } },
        "workspace": { "$ref": "#/$defs/TaskWorkspace" },
        "redScaffold": { "$ref": "#/$defs/RedScaffold" },
        "productCommit": { "$ref": "#/$defs/ProductCommitContract" },
        "evidenceCommit": { "$ref": "#/$defs/EvidenceCommitContract" }
      }
    }
  }
}
