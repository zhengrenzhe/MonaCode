{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://monacode.local/contracts/g5-r/implementation-plan.schema.json",
  "title": "MonaCode G5-R implementation plan manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "planRevision",
    "contract",
    "adoptionState",
    "planState",
    "platformScope",
    "globalConstraints",
    "packageGraph",
    "qualificationEnvironment",
    "evidenceStates",
    "candidateArtifacts",
    "phases",
    "tasks",
    "ownership",
    "documents",
    "audit"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "planRevision": {
      "type": "string",
      "minLength": 1
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "revision"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "revision": {
          "const": "G5-R-full-scope-candidate"
        }
      }
    },
    "adoptionState": {
      "enum": [
        "candidate",
        "adopted"
      ]
    },
    "planState": {
      "enum": [
        "planned",
        "mapped",
        "structurally-verified"
      ]
    },
    "platformScope": {
      "$ref": "#/$defs/nonEmptyStringArray"
    },
    "globalConstraints": {
      "$ref": "#/$defs/nonEmptyStringArray"
    },
    "packageGraph": {
      "$ref": "#/$defs/packageGraph"
    },
    "qualificationEnvironment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest",
        "macOSBuild",
        "chromeVersion",
        "externalDisplayCountRequired",
        "formalDisplayScope"
      ],
      "properties": {
        "manifest": {
          "$ref": "#/$defs/path"
        },
        "macOSBuild": {
          "const": "25G76"
        },
        "chromeVersion": {
          "const": "151.0.7922.138"
        },
        "externalDisplayCountRequired": {
          "const": 0
        },
        "formalDisplayScope": {
          "const": "built-in-display-only"
        }
      }
    },
    "evidenceStates": {
      "type": "array",
      "const": [
        "planned",
        "mapped",
        "structurally-verified"
      ]
    },
    "candidateArtifacts": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "phases": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/phase"
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/task"
      }
    },
    "ownership": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ownership"
      }
    },
    "documents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/document"
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "findingCount",
        "findings"
      ],
      "properties": {
        "status": {
          "enum": [
            "not-run",
            "pass",
            "fail"
          ]
        },
        "findingCount": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "adoptionState": {
            "const": "adopted"
          }
        },
        "required": [
          "adoptionState"
        ]
      },
      "then": {
        "properties": {
          "tasks": {
            "minItems": 1
          },
          "ownership": {
            "minItems": 1
          },
          "documents": {
            "minItems": 1
          },
          "audit": {
            "properties": {
              "status": {
                "const": "pass"
              },
              "findingCount": {
                "const": 0
              },
              "findings": {
                "maxItems": 0
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*[\\*?\\[\\]])[^\\\\]+$"
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run",
        "expectedExit",
        "expectedOutputIncludes"
      ],
      "properties": {
        "run": {
          "type": "string",
          "minLength": 1
        },
        "expectedExit": {
          "type": "integer"
        },
        "expectedOutputIncludes": {
          "$ref": "#/$defs/nonEmptyStringArray"
        }
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "productTarget",
        "create",
        "modify",
        "test"
      ],
      "properties": {
        "productTarget": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "create": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "modify": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "test": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          }
        }
      }
    },
    "interfaces": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumes",
        "produces"
      ],
      "properties": {
        "consumes": {
          "$ref": "#/$defs/stringArray"
        },
        "produces": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "phase",
        "title",
        "platformScope",
        "dependencies",
        "contractRefs",
        "ownership",
        "files",
        "interfaces",
        "red",
        "implementation",
        "green",
        "evidence",
        "completion",
        "commitBoundary"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^P(?:0[0-9])-T[0-9]{3}$"
        },
        "phase": {
          "type": "string",
          "pattern": "^0[0-9]$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "platformScope": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "dependencies": {
          "$ref": "#/$defs/stringArray"
        },
        "contractRefs": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "ownership": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "files": {
          "$ref": "#/$defs/files"
        },
        "interfaces": {
          "$ref": "#/$defs/interfaces"
        },
        "red": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/command"
          }
        },
        "implementation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operations"
          ],
          "properties": {
            "operations": {
              "$ref": "#/$defs/nonEmptyStringArray"
            }
          }
        },
        "green": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/command"
          }
        },
        "evidence": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "completion": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "commitBoundary": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/path"
          }
        }
      }
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "disposition",
        "implementationOwners",
        "testOwners"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "disposition": {
          "type": "string",
          "minLength": 1
        },
        "implementationOwners": {
          "$ref": "#/$defs/stringArray"
        },
        "testOwners": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "document",
        "dependencies"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^0[0-9]$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "document": {
          "$ref": "#/$defs/path"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^0[0-9]$"
          }
        }
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "subject",
        "message"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "packageGraph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "products",
        "nonProductTargets",
        "resources"
      ],
      "properties": {
        "products": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "dependencies"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "dependencies": {
                "$ref": "#/$defs/stringArray"
              }
            }
          }
        },
        "nonProductTargets": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "dependencies"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "dependencies": {
                "$ref": "#/$defs/stringArray"
              }
            }
          }
        },
        "resources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "path",
              "isTarget"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "$ref": "#/$defs/path"
              },
              "isTarget": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  }
}
